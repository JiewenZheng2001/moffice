# ─────────────────────────────────────────────
# MOffice 部署环境变量示例（复制为 .env.local 使用）
#
# 前端（Vercel 项目设置 → Environment Variables 里配置）：
#   VITE_API_BASE=https://moffice-api.onrender.com
#
# 后端（Render 服务 → Environment 里配置）：
#   CORS_ORIGIN=https://moffice.vercel.app
#   JWT_SECRET=<生成一个随机长字符串>
#   PORT=3000（Render 自动注入，无需手动设）
# ─────────────────────────────────────────────

VITE_API_BASE=
